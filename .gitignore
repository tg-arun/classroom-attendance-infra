# Terraform
.terraform/
# .terraform.lock.hcl is committed on purpose - it pins provider versions
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!example.tfvars

# Editors / OS
.DS_Store
.idea/
.vscode/

# Backend config carries the account-specific bucket name
backend.hcl

# Lock files belong to the directories terraform actually runs in
# (environments, bootstrap, and the modules that have tests)
modules/observability/.terraform.lock.hcl
